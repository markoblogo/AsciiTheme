{
  "name": "@abvx/ascii-theme",
  "version": "0.3.0",
  "description": "Framework-agnostic ASCII theme layer with style/theme toggles, theme registry, and ASCII sticker widgets.",
  "homepage": "https://github.com/markoblogo/AsciiTheme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markoblogo/AsciiTheme.git"
  },
  "bugs": {
    "url": "https://github.com/markoblogo/AsciiTheme/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/ascii-theme.es.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "unpkg": "./dist/ascii-theme.umd.js",
  "jsdelivr": "./dist/ascii-theme.umd.js",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ascii-theme.es.js",
      "require": "./dist/index.cjs"
    },
    "./stickers": {
      "types": "./dist/stickers.d.ts",
      "import": "./dist/stickers.es.js",
      "require": "./dist/stickers.cjs"
    },
    "./react": {
      "types": "./packages/react/dist/index.d.ts",
      "import": "./packages/react/dist/index.js",
      "require": "./packages/react/dist/index.cjs"
    },
    "./vue": {
      "types": "./packages/vue/dist/index.d.ts",
      "import": "./packages/vue/dist/index.js",
      "require": "./packages/vue/dist/index.cjs"
    },
    "./web-component": {
      "types": "./packages/web-component/dist/index.d.ts",
      "import": "./packages/web-component/dist/index.js",
      "require": "./packages/web-component/dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./base.css": "./dist/base.css"
  },
  "files": [
    "dist",
    "packages/react/dist",
    "packages/react/README.md",
    "packages/vue/dist",
    "packages/vue/README.md",
    "packages/web-component/dist",
    "packages/web-component/README.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "dist/style.css",
    "dist/base.css",
    "packages/web-component/dist/index.js",
    "packages/web-component/dist/index.cjs"
  ],
  "scripts": {
    "dev": "npm run demo:dev",
    "demo:dev": "vite --mode demo",
    "demo:build": "vite build --mode demo",
    "demo:preview": "vite preview --mode demo",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly && tsc -p packages/react/tsconfig.json --emitDeclarationOnly && tsc -p packages/vue/tsconfig.json --emitDeclarationOnly && tsc -p packages/web-component/tsconfig.json --emitDeclarationOnly",
    "build:modules": "node scripts/build-modules.mjs",
    "build": "npm run build:types && vite build && cp src/base.css dist/base.css && npm run build:modules",
    "preview": "npm run demo:preview",
    "test": "vitest run",
    "docs:capture": "node scripts/visual-regression.mjs --update",
    "verify:integration": "vitest run tests/integration-smoke.test.ts tests/web-component.test.ts tests/core.test.ts tests/stickers.test.ts tests/react.test.tsx tests/vue.test.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:visual": "node scripts/visual-regression.mjs"
  },
  "keywords": [
    "ascii",
    "theme",
    "plugin",
    "css",
    "terminal",
    "retro",
    "theme-toggle",
    "dark-mode",
    "terminal-ui",
    "framework-agnostic"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.4.0 || ^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "esbuild": "^0.25.5",
    "jsdom": "^26.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  }
}
